{
  "name": "asms-rounaqh-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/sitemap.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "content:pull": "node scripts/pull-content.mjs",
    "test:db": "supabase/tests/run.sh",
    "test:admin": "tests/admin-e2e/run.sh",
    "demo": "node scripts/demo-server.mjs",
    "test:browser": "tests/browser/run.sh",
    "test:seller": "tests/seller-e2e/run.sh",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs",
    "theme:build": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs theme build themes/asms/asmsTheme.ts --out app/astryx/asms.css",
    "seed:sql": "node scripts/listings-sql.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.14",
    "@astryxdesign/theme-neutral": "0.7.14",
    "@stylexjs/stylex": "0.19.1",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.14",
    "@cloudflare/vite-plugin": "1.70.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  },
  "type": "module"
}
